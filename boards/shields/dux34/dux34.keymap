/*
 * dux34 Default Keymap
 *
 * 34-key unibody keyboard layout:
 *
 * ╭─────────────────────────╮ ╭─────────────────────────╮
 * │  Q    W    E    R    T  │ │  Y    U    I    O    P  │
 * │  A    S    D    F    G  │ │  H    J    K    L    ;  │
 * │  Z    X    C    V    B  │ │  N    M    ,    .    /  │
 * ╰──────────────╮ NAV  SPC │ │ ENT  SYM ╭──────────────╯
 *                ╰──────────╯ ╰──────────╯
 *
 * Layers:
 *   0: BASE  - QWERTY base layer
 *   1: NAV   - Navigation / numbers
 *   2: SYM   - Symbols / function keys
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define SYM  2

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ─────────────── Layer 0: BASE (QWERTY) ─────────────── */
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T         &kp Y    &kp U    &kp I     &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G         &kp H    &kp J    &kp K     &kp L    &kp SEMI
                &kp Z    &kp X    &kp C    &kp V    &kp B         &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH
                                           &mo NAV  &kp SPACE     &kp RET  &mo SYM
            >;
        };

        /* ─────────────── Layer 1: NAV (导航 / 数字) ─────────────── */
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4   &kp N5        &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
                &kp TAB  &kp LGUI &kp LALT &kp LSFT &kp LCTL      &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp BSPC
                &kp LCTL &kp LALT &kp LGUI &kp ESC  &kp CAPS      &kp HOME &kp PGDN &kp PGUP &kp END  &kp DEL
                                            &trans   &trans        &kp RET  &mo SYM
            >;
        };

        /* ─────────────── Layer 2: SYM (符号 / 功能键) ─────────────── */
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp STAR  &kp LPAR &kp RPAR
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5        &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
                &kp F6   &kp F7   &kp F8   &kp F9   &kp F10       &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE
                                            &mo NAV  &kp SPACE     &trans    &trans
            >;
        };
    };
};
