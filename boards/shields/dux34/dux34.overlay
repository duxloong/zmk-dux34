#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* row0 -> D4  (P0.22) */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* row1 -> D5  (P0.24) */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* row2 -> D6  (P1.00) */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* row3 -> D7  (P0.11) */
            ;

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH> /* col0 -> D21 (P0.31) */
            , <&gpio0 29 GPIO_ACTIVE_HIGH> /* col1 -> D20 (P0.29) */
            , <&gpio0  2 GPIO_ACTIVE_HIGH> /* col2 -> D19 (P0.02) */
            , <&gpio1 15 GPIO_ACTIVE_HIGH> /* col3 -> D18 (P1.15) */
            , <&gpio1 13 GPIO_ACTIVE_HIGH> /* col4 -> D15 (P1.13) */
            , <&gpio1 11 GPIO_ACTIVE_HIGH> /* col5 -> D14 (P1.11) */
            , <&gpio0 10 GPIO_ACTIVE_HIGH> /* col6 -> D16 (P0.10) */
            , <&gpio0  9 GPIO_ACTIVE_HIGH> /* col7 -> D10 (P0.09) */
            , <&gpio0  6 GPIO_ACTIVE_HIGH> /* col8 -> D9  (P0.06) */
            , <&gpio0  8 GPIO_ACTIVE_HIGH> /* col9 -> D8  (P0.08) */
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        /* * 映射键盘矩阵。RC(行, 列) 代表原理图上的交点。
         * Dux34 的最后一行（row3）只有 col4, col5, col6, col7 四个拇指键。
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                            RC(3,4) RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };
};