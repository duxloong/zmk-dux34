#include <dt-bindings/led/led.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/zmk/matrix_transform.h>

&pinctrl {
    /* 1. 配置引脚复用：将 P0.06 (D1) 设置为 PWM 输出引脚 */
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 6)>; /* 0, 6 代表 P0.06，即 D1 引脚 */
            nordic,drive-mode = <NRF_DRIVE_H0H1>; /* 增强引脚驱动能力 */
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 6)>;
            low-power-enable;
        };
    };
};

/* 2. 启用 PWM0 模块并绑定刚才配置的引脚 */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    /* 3. 创建基于 PWM 的 WS2812 灯带节点 */
    led_strip: ws2812_pwm {
        compatible = "worldsemi,ws2812-pwm";
        label = "WS2812_PWM";

        /* 将原来的 PWM_KHZ(800) 改为 1250 纳秒周期，将 PWM_POLARITY_INVERTED 改为 1 */
        pwms = <&pwm0 0 1250 1>;

        /* 硬件具体时序参数 */
        t-zero-ns = <350>;
        t-one-ns = <700>;
        reset-ns = <280000>;

        chain-length = <1>; /* 如果串联了多颗，修改这里的数量 */
        /* 将 LED_COLOR_CH_XXX 宏直接替换为数字：0代表红，1代表绿，2代表蓝 */
        color-mapping = <0 1 2>; 
    };

    /* 4. 告诉 ZMK 系统的 Underglow 绑定到这个灯带 */
    chosen {
        zmk,underglow = &led_strip;
    };
};


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Key matrix transform:
     * 34 keys total
     * Row0: 10 keys (col0..col9)  -> positions 0..9
     * Row1: 10 keys (col0..col9)  -> positions 10..19
     * Row2: 10 keys (col0..col9)  -> positions 20..29
     * Row3:  4 keys (col3..col6)  -> positions 30..33
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)    RC(3,5) RC(3,6)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";

        /* col2row: cols driven HIGH, rows read with pull-down */
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row0: D4 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row1: D5 */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row2: D6 */
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row3: D7 */
            ;

        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* col0: D21 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* col1: D20 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* col2: D19 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* col3: D18 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* col4: D15 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* col5: D14 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>   /* col6: D16 */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>   /* col7: D10 */
            , <&pro_micro  9 GPIO_ACTIVE_HIGH>   /* col8: D9  (NFC pin P0.10) */
            , <&pro_micro  8 GPIO_ACTIVE_HIGH>   /* col9: D8  (NFC pin P0.09) */
            ;
    };
};