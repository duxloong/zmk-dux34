/*
 * RGB LED on D1 (P0.06) via SPI3 (SPIM3)
 * LED type: WS2812-compatible addressable RGB LED
 * Data: D1 (P0.06) = MOSI, single-wire self-clocked protocol
 */

#include <dt-bindings/led/led.h>

/*
 * dux34 Keyboard Shield
 *
 * MCU: Nice!Nano (NRF52840)
 * Matrix: 4 rows x 10 cols = 34 keys (one-piece unibody)
 *
 * Using &pro_micro pin aliases to avoid manual GPIO mapping errors.
 * The nice_nano_v2 board definition handles Pro Micro -> NRF52840 GPIO translation.
 *
 * Pin Connections (Pro Micro label -> function):
 *   Rows (INPUT, pull-down, col2row diode direction):
 *     row0: D4  (P0.20)
 *     row1: D5  (P0.22)
 *     row2: D6  (P0.24)
 *     row3: D7  (P1.00)
 *
 *   Cols (OUTPUT, driven high):
 *     col0: D21 (P0.31)
 *     col1: D20 (P0.29)
 *     col2: D19 (P1.15)
 *     col3: D18 (P1.13)
 *     col4: D15 (P0.03)
 *     col5: D14 (P0.02)
 *     col6: D16 (P1.11)
 *     col7: D10 (P1.06)
 *     col8: D9  (P0.10) <- NFC pin, needs CONFIG_NFCT_PINS_AS_GPIOS=y
 *     col9: D8  (P0.09) <- NFC pin, needs CONFIG_NFCT_PINS_AS_GPIOS=y
 *
 * Diode direction: col2row
 *   Diode anode on col side, cathode on row side.
 *   Current: col (HIGH) -> switch -> diode -> row (read)
 *
 * Matrix Layout (4x10, 34 keys):
 *   Row0: col0~col9 (10 keys) - top row
 *   Row1: col0~col9 (10 keys) - home row
 *   Row2: col0~col9 (10 keys) - bottom row
 *   Row3: col3~col6 ( 4 keys) - thumb cluster
 */

#include <dt-bindings/zmk/matrix_transform.h>


/* ─── SPI3 pinctrl: MOSI = D1 (P0.06), SCK = dummy (P0.08) ─── */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_SCK, 0, 8)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_SCK, 0, 8)>;
            low-power-enable;
        };
    };
};

/* ─── SPI3 peripheral + WS2812 LED node ─── */
&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        spi-one-frame  = <0x70>;
        spi-zero-frame = <0x40>;
        chain-length = <1>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Key matrix transform:
     * 34 keys total
     * Row0: 10 keys (col0..col9)  -> positions 0..9
     * Row1: 10 keys (col0..col9)  -> positions 10..19
     * Row2: 10 keys (col0..col9)  -> positions 20..29
     * Row3:  4 keys (col3..col6)  -> positions 30..33
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)    RC(3,5) RC(3,6)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";

        /* col2row: cols driven HIGH, rows read with pull-down */
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row0: D4 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row1: D5 */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row2: D6 */
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* row3: D7 */
            ;

        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* col0: D21 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* col1: D20 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* col2: D19 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* col3: D18 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* col4: D15 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* col5: D14 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>   /* col6: D16 */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>   /* col7: D10 */
            , <&pro_micro  9 GPIO_ACTIVE_HIGH>   /* col8: D9  (NFC pin P0.10) */
            , <&pro_micro  8 GPIO_ACTIVE_HIGH>   /* col9: D8  (NFC pin P0.09) */
            ;
    };
};

/*
 * Disable UART0 to completely free up D0 (P0.08) and D1 (P0.06)
 * This prevents any potential pin conflicts with our SPI3 setup.
 */
&uart0 {
    status = "disabled";
};
