/*
 * dux34 Keyboard Shield
 *
 * MCU: Nice!Nano (NRF52840)
 * Matrix: 4 rows x 10 cols = 34 keys (one-piece unibody)
 *
 * Pin Mapping (Pro Micro label -> NRF52840 GPIO):
 *   Rows (OUTPUT):
 *     row0: D4  -> P0.22
 *     row1: D5  -> P0.24
 *     row2: D6  -> P1.00
 *     row3: D7  -> P0.11
 *
 *   Cols (INPUT, pull-up):
 *     col0: D21 -> P0.31
 *     col1: D20 -> P0.29
 *     col2: D19 -> P0.02
 *     col3: D18 -> P1.15
 *     col4: D15 -> P1.13
 *     col5: D14 -> P1.11
 *     col6: D16 -> P0.10
 *     col7: D10 -> P0.09
 *     col8: D8  -> P1.04
 *     col9: D9  -> P1.06
 *
 * Matrix Layout (4x10, 34 keys):
 *   Row0: col0~col9 (10 keys) - top row
 *   Row1: col0~col9 (10 keys) - home row
 *   Row2: col0~col9 (10 keys) - bottom row
 *   Row3: col3~col6 ( 4 keys) - thumb cluster
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Key matrix transform:
     * 34 keys total
     * Row0: 10 keys (col0..col9)  -> positions 0..9
     * Row1: 10 keys (col0..col9)  -> positions 10..19
     * Row2: 10 keys (col0..col9)  -> positions 20..29
     * Row3:  4 keys (col3..col6)  -> positions 30..33
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)    RC(3,5) RC(3,6)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "row2col";

        row-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH>    /* row0: D4 / P0.22 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>    /* row1: D5 / P0.24 */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>    /* row2: D6 / P1.00 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>    /* row3: D7 / P0.11 */
            ;

        col-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col0: D21 / P0.31 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col1: D20 / P0.29 */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col2: D19 / P0.02 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col3: D18 / P1.15 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col4: D15 / P1.13 */
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col5: D14 / P1.11 */
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col6: D16 / P0.10 */
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col7: D10 / P0.09 */
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col8: D8  / P1.04 */
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* col9: D9  / P1.06 */
            ;
    };
};
