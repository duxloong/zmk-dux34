config SHIELD_DUX34
    def_bool $(shields_list_contains,dux34)

# DUX34 专属 LED 状态指示 widget
config DUX34_LED_WIDGET
    bool "DUX34 WS2812 LED battery/charging status widget"
    depends on SHIELD_DUX34
    select LED_STRIP
    select SPI
    select ZMK_BATTERY_REPORTING
    help
      Enable WS2812 RGB LED status indicator on D1 pin (P0.06, via SPI3):
        Yellow = Charging (USB connected, battery < 100%)
        Blue   = Fully charged (USB connected, battery = 100%)
        Red    = Low battery (battery < 20%)
        Off    = Normal use

      Uses a dedicated work queue (not ZMK's low-priority queue)
      to avoid stack overflow during SPI operations.
